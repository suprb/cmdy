{
  "name": "cmdy-site",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-brand.mjs && vite --host 127.0.0.1 --port 4173",
    "build": "node scripts/sync-brand.mjs && tsc --noEmit && vite build",
    "test": "npm run build && npm run verify && npm run render-smoke",
    "render-smoke": "node scripts/render-smoke.mjs",
    "snapshot": "node scripts/update-marketplace-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
