{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdy.dev/schemas/extension-manifest-v1.schema.json",
  "title": "Cmdy Extension Manifest v1",
  "type": "object",
  "required": ["manifestVersion", "id", "name", "version", "entrypoint", "capabilities"],
  "properties": {
    "manifestVersion": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$"
    },
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "entrypoint": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}
    },
    "enabled": {"type": "boolean", "default": true},
    "description": {"type": "string"},
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whatItDoes": {"$ref": "#/$defs/guideLines"},
        "safety": {"$ref": "#/$defs/guideLines"},
        "setup": {"$ref": "#/$defs/guideLines"}
      }
    },
    "homepage": {"type": "string", "format": "uri"},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "events.read", "panes.read", "panes.type", "panes.manage",
          "commands", "hotkeys", "ui.panels", "ui.surfaces",
          "ui.companion", "notifications", "channels", "hooks",
          "marketplace.install", "debug"
        ]
      }
    }
  },
  "$defs": {
    "guideLines": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 1024}
    }
  },
  "additionalProperties": true
}
