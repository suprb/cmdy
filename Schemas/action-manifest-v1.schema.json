{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdy.dev/schemas/action-manifest-v1.schema.json",
  "title": "Cmdy Action Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "title"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*[A-Za-z0-9_-]$|^[A-Za-z0-9]$"
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "description": { "type": "string", "maxLength": 1024 },
    "guide": { "$ref": "#/$defs/guide" },
    "group": { "type": "string", "maxLength": 80 },
    "shortcut": {
      "type": "string",
      "pattern": "^(cmd|command|option|opt|alt|control|ctrl)(\\+(cmd|command|shift|option|opt|alt|control|ctrl))*\\+[^+]{1}$"
    },
    "confirmation": { "type": "string", "maxLength": 512 },
    "command": { "type": "string", "minLength": 1, "maxLength": 65536 },
    "entrypoint": { "$ref": "#/$defs/safePath" },
    "pane": { "$ref": "#/$defs/pane" },
    "mode": { "$ref": "#/$defs/mode" },
    "cwd": { "$ref": "#/$defs/cwd" },
    "inputs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/input" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/step" }
    },
    "whenFiles": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/safePath" }
    }
  },
  "oneOf": [
    { "required": ["command"], "not": { "anyOf": [{ "required": ["entrypoint"] }, { "required": ["steps"] }] } },
    { "required": ["entrypoint"], "not": { "anyOf": [{ "required": ["command"] }, { "required": ["steps"] }] } },
    { "required": ["steps"], "not": { "anyOf": [{ "required": ["command"] }, { "required": ["entrypoint"] }] } }
  ],
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/|^~|(^|/)\\.\\.(/|$)|//)" }
    },
    "pane": { "enum": ["focused", "right", "down"] },
    "mode": { "enum": ["run", "type"] },
    "cwd": { "enum": ["focused", "project", "action"] },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whatItDoes": { "$ref": "#/$defs/guideLines" },
        "safety": { "$ref": "#/$defs/guideLines" },
        "setup": { "$ref": "#/$defs/guideLines" }
      }
    },
    "guideLines": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "maxLength": 128 },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["text", "secure", "toggle", "choice"] },
        "default": { "type": "string" },
        "placeholder": { "type": "string", "maxLength": 512 },
        "options": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "maxLength": 512 }
        },
        "required": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "entrypoint": { "$ref": "#/$defs/safePath" },
        "pane": { "$ref": "#/$defs/pane" },
        "mode": { "$ref": "#/$defs/mode" },
        "cwd": { "$ref": "#/$defs/cwd" }
      },
      "oneOf": [
        { "required": ["command"], "not": { "required": ["entrypoint"] } },
        { "required": ["entrypoint"], "not": { "required": ["command"] } }
      ]
    }
  }
}
